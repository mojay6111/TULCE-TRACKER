# ============================================================
#  TULCE TRACKER — .gitignore
# ============================================================

# ----- Environment variables (NEVER push these) -----
.env
.env.local
.env.development
.env.production
.env.test
*.env

# ----- Node modules -----
node_modules/
backend/node_modules/
frontend/node_modules/

# ----- Prisma generated client -----
backend/node_modules/.prisma/
backend/node_modules/@prisma/

# ----- Vite build output -----
frontend/dist/
frontend/dist-ssr/
frontend/.vite/

# ----- Logs -----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ----- Runtime / cache -----
.cache/
.parcel-cache/
*.pid
*.seed
*.pid.lock

# ----- OS generated files -----
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Mac
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~

# ----- VS Code -----
.vscode/
!.vscode/extensions.json

# ----- JetBrains IDEs -----
.idea/
*.iml

# ----- Testing -----
coverage/
*.lcov

# ----- Misc -----
*.zip
*.tar.gz